[{"word":"empati","meaning":"同理心","theme":"T23","level":"L4–L8","type":"tema","usage":"keupayaan memahami perasaan dan keadaan orang lain｜理解他人感受和处境的能力","example":"Empati membantu kita memahami kesusahan orang lain.","related":"prihatin, belas kasihan, toleransi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"toleransi","meaning":"包容；宽容","theme":"T23","level":"L4–L8","type":"tema","usage":"kesediaan menghormati perbezaan secara wajar｜尊重差异并适当接纳他人","example":"Toleransi penting dalam masyarakat majmuk.","related":"hormat, perpaduan, keharmonian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kerjasama","meaning":"合作","theme":"T14","level":"L1–L8","type":"tema","usage":"usaha yang dilakukan bersama-sama｜共同进行的努力","example":"Program itu berjaya hasil kerjasama semua pihak.","related":"bekerjasama, muafakat, gotong-royong","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"muafakat","meaning":"协商一致；共识","theme":"T14","level":"L4–L8","type":"tema","usage":"persetujuan yang dicapai melalui perbincangan｜通过协商达成的共识","example":"Keputusan dibuat secara muafakat.","related":"kerjasama, persetujuan, perbincangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"perpaduan","meaning":"团结","theme":"T14","level":"L3–L8","type":"tema","usage":"keadaan masyarakat yang bersatu dan harmoni｜社会团结和谐的状态","example":"Aktiviti bersama dapat memupuk perpaduan.","related":"keharmonian, kerjasama, toleransi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"keharmonian","meaning":"和谐","theme":"T14","level":"L3–L8","type":"tema","usage":"keadaan aman dan baik dalam hubungan masyarakat｜社会关系和平良好的状态","example":"Sikap saling menghormati mengekalkan keharmonian.","related":"perpaduan, toleransi, muafakat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kejiranan","meaning":"邻里；社区邻里关系","theme":"T14","level":"L2–L8","type":"tema","usage":"hal yang berkaitan dengan jiran dan kawasan tempat tinggal｜与邻居和居住区有关的事","example":"Aktiviti kejiranan mengeratkan hubungan penduduk.","related":"jiran, komuniti, gotong-royong","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"gotong-royong","meaning":"互助劳动","theme":"T14","level":"L1–L8","type":"tema","usage":"kerja bersama-sama secara sukarela untuk kepentingan bersama｜为了共同利益自愿一起劳动","example":"Penduduk mengadakan gotong-royong membersihkan kawasan.","related":"kerjasama, komuniti, kebersihan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kesihatan","meaning":"健康","theme":"T07","level":"L1–L8","type":"tema","usage":"keadaan tubuh dan minda yang baik｜身体和心理处于良好状态","example":"Kita perlu menjaga kesihatan diri.","related":"sihat, kecergasan, pemakanan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"sihat","meaning":"健康的","theme":"T07","level":"L1–L8","type":"adjektif","usage":"berada dalam keadaan tubuh dan minda yang baik｜身体和心理状态良好","example":"Makanan berkhasiat membantu kita kekal sihat.","related":"kesihatan, cergas, pemakanan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"cergas","meaning":"精力充沛；健壮","theme":"T07","level":"L2–L8","type":"adjektif","usage":"aktif dan bertenaga｜活跃且有活力","example":"Bersenam menjadikan badan cergas.","related":"aktif, sihat, kecergasan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pemakanan seimbang","meaning":"均衡饮食","theme":"T10","level":"L2–L8","type":"tema","usage":"pengambilan makanan yang pelbagai dan sesuai mengikut keperluan｜按需要摄取多样且适当的食物","example":"Pemakanan seimbang penting untuk kesihatan.","related":"khasiat, nutrien, makanan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"khasiat","meaning":"营养价值；益处","theme":"T10","level":"L2–L8","type":"tema","usage":"faedah yang terdapat dalam makanan kepada tubuh｜食物对身体的益处","example":"Buah-buahan mempunyai banyak khasiat.","related":"nutrien, pemakanan, sihat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kebersihan","meaning":"清洁；卫生","theme":"T08","level":"L1–L8","type":"tema","usage":"keadaan bersih dan bebas daripada kekotoran｜清洁没有污垢的状态","example":"Kebersihan kelas perlu dijaga.","related":"bersih, higien, kesihatan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"bersih","meaning":"干净的","theme":"T08","level":"L1–L8","type":"adjektif","usage":"tidak kotor dan terpelihara daripada kekotoran｜没有污垢且保持清洁","example":"Pastikan tangan sentiasa bersih.","related":"kebersihan, kotor, higien","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"keselamatan","meaning":"安全","theme":"T09","level":"L1–L8","type":"tema","usage":"keadaan terlindung daripada bahaya｜免受危险的状态","example":"Keselamatan murid menjadi keutamaan.","related":"bahaya, risiko, perlindungan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"bahaya","meaning":"危险","theme":"T09","level":"L1–L8","type":"tema","usage":"sesuatu yang boleh menyebabkan kecederaan atau kerosakan｜可能造成伤害或损坏的事物","example":"Jangan bermain di tempat yang berbahaya.","related":"risiko, keselamatan, ancaman","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"risiko","meaning":"风险","theme":"T09","level":"L3–L8","type":"tema","usage":"kemungkinan berlakunya bahaya atau kerugian｜发生危险或损失的可能性","example":"Pemakaian topi keledar mengurangkan risiko kecederaan.","related":"bahaya, pencegahan, keselamatan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pencegahan","meaning":"预防","theme":"T09","level":"L3–L8","type":"tema","usage":"tindakan untuk mengelakkan sesuatu masalah atau bahaya berlaku｜防止问题或危险发生的行动","example":"Pencegahan lebih baik daripada membiarkan masalah berlarutan.","related":"mencegah, langkah, keselamatan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"alam sekitar","meaning":"环境","theme":"T11","level":"L1–L8","type":"tema","usage":"keadaan dan unsur di sekeliling manusia dan hidupan｜人类和生物周围的环境与因素","example":"Kita bertanggungjawab menjaga alam sekitar.","related":"pencemaran, pemuliharaan, kelestarian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pencemaran","meaning":"污染","theme":"T11","level":"L2–L8","type":"tema","usage":"keadaan alam yang tercemar oleh bahan atau kegiatan tertentu｜环境受到物质或活动污染的状态","example":"Pencemaran sungai menjejaskan hidupan air.","related":"tercemar, alam sekitar, sisa","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pemuliharaan","meaning":"保育；保护","theme":"T11","level":"L4–L8","type":"tema","usage":"usaha melindungi dan mengekalkan sumber alam atau warisan｜保护并维持自然资源或遗产的努力","example":"Pemuliharaan hutan penting untuk biodiversiti.","related":"melindungi, kelestarian, alam sekitar","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kelestarian","meaning":"可持续性","theme":"T11","level":"L5–L8","type":"tema","usage":"keadaan yang dapat dikekalkan tanpa menjejaskan masa depan｜能够持续而不损害未来的状态","example":"Amalan hijau menyokong kelestarian alam.","related":"mampan, alam sekitar, pemuliharaan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ekosistem","meaning":"生态系统","theme":"T11","level":"L4–L8","type":"tema","usage":"hubungan antara hidupan dengan persekitarannya｜生物与环境之间相互关系的系统","example":"Hutan ialah ekosistem yang penting.","related":"habitat, biodiversiti, alam sekitar","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"habitat","meaning":"栖息地","theme":"T12","level":"L2–L8","type":"tema","usage":"tempat semula jadi sesuatu hidupan tinggal｜生物自然生活的地方","example":"Hutan merupakan habitat harimau.","related":"spesies, ekosistem, hidupan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"spesies","meaning":"物种","theme":"T12","level":"L4–L8","type":"tema","usage":"kumpulan organisma yang mempunyai ciri tertentu yang sama｜具有共同特征的一类生物","example":"Spesies itu semakin berkurangan.","related":"habitat, biodiversiti, kepupusan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kepupusan","meaning":"灭绝","theme":"T12","level":"L4–L8","type":"tema","usage":"keadaan sesuatu spesies hilang sepenuhnya｜某物种完全消失的状态","example":"Pemburuan haram boleh menyebabkan kepupusan.","related":"spesies, pemuliharaan, habitat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"biodiversiti","meaning":"生物多样性","theme":"T12","level":"L5–L8","type":"tema","usage":"kepelbagaian hidupan dalam sesuatu kawasan｜某地区生物种类的多样性","example":"Hutan hujan kaya dengan biodiversiti.","related":"spesies, ekosistem, pemuliharaan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"cuaca","meaning":"天气","theme":"T13","level":"L1–L8","type":"tema","usage":"keadaan udara pada sesuatu masa dan tempat｜某时间地点的大气状况","example":"Cuaca hari ini cerah.","related":"hujan, panas, mendung","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"iklim","meaning":"气候","theme":"T13","level":"L4–L8","type":"tema","usage":"corak keadaan cuaca dalam tempoh panjang｜长期的天气模式","example":"Malaysia beriklim khatulistiwa.","related":"cuaca, perubahan iklim, suhu","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"}]