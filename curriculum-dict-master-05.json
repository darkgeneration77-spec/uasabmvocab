[{"word":"menangani masalah","meaning":"处理问题","theme":"T24","level":"L3–L8","type":"frasa","usage":"digunakan untuk menyatakan usaha mengurus dan menyelesaikan masalah｜表示处理并解决问题","example":"Kerajaan berusaha menangani masalah kesesakan.","related":"mengatasi masalah, langkah, usaha","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memupuk semangat","meaning":"培养精神","theme":"T23","level":"L3–L8","type":"frasa","usage":"digunakan untuk membina sikap atau semangat secara berterusan｜用于持续培养态度或精神","example":"Aktiviti sukan memupuk semangat kerjasama.","related":"menyemai, semangat, kerjasama","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"meningkatkan kesedaran","meaning":"提高意识","theme":"T23","level":"L4–L8","type":"frasa","usage":"digunakan untuk menjadikan orang lebih peka terhadap sesuatu isu｜让人更关注某议题","example":"Kempen itu meningkatkan kesedaran tentang kebersihan.","related":"kesedaran, kempen, prihatin","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memberikan perhatian","meaning":"给予关注","theme":"T23","level":"L2–L8","type":"frasa","usage":"digunakan apabila seseorang menumpukan perhatian pada sesuatu｜表示把注意力放在某事上","example":"Ibu bapa perlu memberikan perhatian kepada pelajaran anak.","related":"mengambil berat, prihatin","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengambil berat","meaning":"关心；重视","theme":"T23","level":"L2–L8","type":"frasa","usage":"digunakan apabila seseorang menunjukkan keprihatinan｜表示对人或事情关心","example":"Kita mesti mengambil berat tentang kebajikan jiran.","related":"prihatin, memberikan perhatian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menjaga kebajikan","meaning":"照顾福利","theme":"T23","level":"L3–L8","type":"frasa","usage":"digunakan untuk menyatakan usaha melindungi kepentingan dan kesejahteraan orang lain｜表示照顾他人的利益与福祉","example":"Masyarakat perlu menjaga kebajikan warga emas.","related":"kebajikan, prihatin, tanggungjawab","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memainkan peranan","meaning":"发挥作用","theme":"T25","level":"L3–L8","type":"frasa","usage":"digunakan untuk menerangkan tugas atau sumbangan sesuatu pihak｜说明某方的作用或职责","example":"Ibu bapa memainkan peranan penting dalam pendidikan anak.","related":"peranan, tanggungjawab, sumbangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memberikan sumbangan","meaning":"作出贡献","theme":"T23","level":"L3–L8","type":"frasa","usage":"digunakan untuk menyatakan bantuan atau usaha yang diberikan｜表示提供帮助或贡献","example":"Belia memberikan sumbangan kepada masyarakat.","related":"sumbangan, membantu, masyarakat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengekalkan keharmonian","meaning":"维持和谐","theme":"T14","level":"L4–L8","type":"frasa","usage":"digunakan untuk menyatakan usaha memastikan hubungan kekal aman｜表示维持关系和平","example":"Sikap hormat membantu mengekalkan keharmonian.","related":"keharmonian, perpaduan, toleransi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mempererat hubungan","meaning":"加强关系","theme":"T14","level":"L4–L8","type":"frasa","usage":"digunakan untuk menjadikan hubungan lebih rapat｜让关系更加紧密","example":"Gotong-royong dapat mempererat hubungan kejiranan.","related":"hubungan, kejiranan, kerjasama","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"keluarga","meaning":"家庭","theme":"T05","level":"L1–L8","type":"tema","usage":"kumpulan orang yang mempunyai hubungan kekeluargaan｜具有亲属关系的一群人","example":"Keluarga saya tinggal di Pulau Pinang.","related":"ibu, bapa, adik-beradik","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ibu bapa","meaning":"父母","theme":"T05","level":"L1–L8","type":"tema","usage":"ibu dan bapa seseorang｜一个人的父亲和母亲","example":"Ibu bapa membimbing anak-anak.","related":"keluarga, anak, penjaga","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"adik-beradik","meaning":"兄弟姐妹","theme":"T05","level":"L1–L8","type":"tema","usage":"saudara kandung dalam sesebuah keluarga｜家庭中的兄弟姐妹","example":"Mereka saling membantu sebagai adik-beradik.","related":"keluarga, saudara","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kasih sayang","meaning":"关爱；爱护","theme":"T05","level":"L1–L8","type":"tema","usage":"perasaan sayang dan mengambil berat｜关爱与关心的感情","example":"Ibu bapa mencurahkan kasih sayang kepada anak.","related":"prihatin, keluarga, hormat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"tanggungjawab","meaning":"责任","theme":"T23","level":"L1–L8","type":"tema","usage":"kewajipan yang perlu dilaksanakan dengan baik｜应妥善履行的义务","example":"Menjaga kebersihan ialah tanggungjawab bersama.","related":"amanah, peranan, kewajipan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"amanah","meaning":"诚信；受托责任","theme":"T23","level":"L2–L8","type":"tema","usage":"sikap boleh dipercayai dalam melaksanakan tanggungjawab｜值得信赖并履行责任的品质","example":"Ketua kelas perlu bersikap amanah.","related":"jujur, tanggungjawab, integriti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"jujur","meaning":"诚实","theme":"T04","level":"L1–L8","type":"adjektif","usage":"bercakap dan bertindak dengan benar｜说话和行动真实不欺骗","example":"Kita hendaklah jujur dalam setiap urusan.","related":"amanah, ikhlas, integriti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ikhlas","meaning":"真诚；诚心","theme":"T04","level":"L3–L8","type":"adjektif","usage":"melakukan sesuatu dengan hati yang tulus｜真心诚意地做某事","example":"Dia membantu jirannya dengan ikhlas.","related":"jujur, tulus, sukarela","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"rajin","meaning":"勤劳；勤奋","theme":"T04","level":"L1–L8","type":"adjektif","usage":"suka berusaha dan tidak malas｜勤于努力而不懒惰","example":"Aina rajin mengulang kaji pelajaran.","related":"tekun, gigih, malas","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"tekun","meaning":"专心；勤奋","theme":"T04","level":"L2–L8","type":"adjektif","usage":"bersungguh-sungguh dan berterusan dalam melakukan sesuatu｜持续认真地做事","example":"Dia tekun menyiapkan latihan.","related":"rajin, gigih, fokus","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"gigih","meaning":"坚毅；勤奋不懈","theme":"T04","level":"L3–L8","type":"adjektif","usage":"berusaha dengan bersungguh-sungguh dan tidak mudah menyerah｜坚持努力不轻易放弃","example":"Dia berusaha dengan gigih untuk berjaya.","related":"tekun, cekal, tabah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"cekal","meaning":"坚毅；不屈","theme":"T04","level":"L4–L8","type":"adjektif","usage":"tetap kuat menghadapi kesukaran｜面对困难仍保持坚定","example":"Dia cekal menghadapi cabaran.","related":"tabah, gigih, berani","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"tabah","meaning":"坚强；坚忍","theme":"T04","level":"L3–L8","type":"adjektif","usage":"kuat hati menghadapi kesusahan｜面对困难时坚强","example":"Mangsa banjir itu tetap tabah.","related":"cekal, sabar, gigih","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"berani","meaning":"勇敢","theme":"T04","level":"L1–L8","type":"adjektif","usage":"tidak takut menghadapi bahaya atau cabaran yang wajar｜敢于面对合理的危险或挑战","example":"Dia berani menyatakan kebenaran.","related":"yakin, cekal, takut","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"yakin","meaning":"有信心；相信","theme":"T04","level":"L2–L8","type":"adjektif","usage":"mempunyai kepercayaan yang kuat terhadap diri atau sesuatu｜对自己或某事有信心","example":"Dia yakin dapat menjawab soalan itu.","related":"keyakinan, percaya, berani","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"bijaksana","meaning":"明智；智慧","theme":"T04","level":"L4–L8","type":"adjektif","usage":"pandai membuat pertimbangan yang baik｜善于作出明智判断","example":"Pemimpin yang bijaksana membuat keputusan dengan teliti.","related":"cerdik, pertimbangan, adil","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"adil","meaning":"公平；公正","theme":"T23","level":"L2–L8","type":"adjektif","usage":"memberikan hak atau layanan secara saksama｜公平给予权利或待遇","example":"Guru itu bersikap adil kepada semua murid.","related":"keadilan, saksama, jujur","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"sopan","meaning":"有礼貌","theme":"T04","level":"L1–L8","type":"adjektif","usage":"bertingkah laku dengan baik dan beradab｜行为有礼有教养","example":"Murid bercakap dengan sopan.","related":"santun, hormat, adab","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"santun","meaning":"文雅；有礼","theme":"T04","level":"L2–L8","type":"adjektif","usage":"berbahasa dan bertingkah laku secara beradab｜语言和行为有礼","example":"Gunakan bahasa yang santun.","related":"sopan, kesantunan, adab","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"prihatin","meaning":"关心；关注","theme":"T23","level":"L2–L8","type":"adjektif","usage":"peka dan mengambil berat terhadap orang atau keadaan｜留意并关心他人或情况","example":"Kita perlu prihatin terhadap golongan memerlukan.","related":"empati, mengambil berat, kebajikan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"}]