[{"word":"kata majmuk","meaning":"复合词","theme":"T28","level":"L3–L8","type":"imbuhan","usage":"gabungan dua kata atau lebih yang membawa satu maksud｜两个或以上词组成一个意义","example":"Kereta api ialah kata majmuk.","related":"kata dasar, kata ganda, kata terbitan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata ganda","meaning":"重叠词","theme":"T28","level":"L2–L8","type":"imbuhan","usage":"kata yang terbentuk melalui penggandaan｜通过重叠构成的词","example":"Murid-murid sedang beratur.","related":"penggandaan, kata dasar","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata dasar","meaning":"词根；基本词","theme":"T28","level":"L2–L8","type":"imbuhan","usage":"kata yang belum menerima imbuhan｜尚未加词缀的基本词","example":"Tulis ialah kata dasar bagi menulis.","related":"imbuhan, kata terbitan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata terbitan","meaning":"派生词","theme":"T28","level":"L3–L8","type":"imbuhan","usage":"kata yang terbentuk apabila kata dasar menerima imbuhan｜词根加词缀形成的词","example":"Penulisan ialah kata terbitan.","related":"kata dasar, imbuhan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"awalan","meaning":"前缀","theme":"T28","level":"L2–L8","type":"imbuhan","usage":"imbuhan yang hadir di hadapan kata dasar｜加在词根前面的词缀","example":"MeN- ialah imbuhan awalan.","related":"imbuhan, akhiran, apitan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"akhiran","meaning":"后缀","theme":"T28","level":"L3–L8","type":"imbuhan","usage":"imbuhan yang hadir selepas kata dasar｜加在词根后面的词缀","example":"-kan ialah imbuhan akhiran.","related":"imbuhan, awalan, apitan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"apitan","meaning":"环缀；前后缀","theme":"T28","level":"L3–L8","type":"imbuhan","usage":"imbuhan yang hadir serentak di hadapan dan belakang kata dasar｜同时加在词根前后的词缀","example":"Ke-...-an ialah imbuhan apitan.","related":"imbuhan, awalan, akhiran","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"sisipan","meaning":"中缀","theme":"T28","level":"L5–L8","type":"imbuhan","usage":"imbuhan yang disisipkan ke dalam kata dasar｜插入词根内部的词缀","example":"Sisipan ialah salah satu bentuk imbuhan.","related":"imbuhan, awalan, akhiran","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"subjek","meaning":"主语","theme":"T28","level":"L3–L8","type":"tugas","usage":"bahagian ayat yang diterangkan oleh predikat｜句子中被谓语说明的部分","example":"Ali ialah subjek dalam ayat itu.","related":"predikat, ayat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"predikat","meaning":"谓语","theme":"T28","level":"L3–L8","type":"tugas","usage":"bahagian ayat yang menerangkan subjek｜说明主语的句子部分","example":"Sedang membaca ialah predikat.","related":"subjek, ayat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"frasa nama","meaning":"名词短语","theme":"T28","level":"L4–L8","type":"frasa","usage":"frasa yang inti utamanya kata nama｜核心为名词的短语","example":"Murid rajin itu ialah frasa nama.","related":"frasa kerja, frasa adjektif","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"frasa kerja","meaning":"动词短语","theme":"T28","level":"L4–L8","type":"frasa","usage":"frasa yang inti utamanya kata kerja｜核心为动词的短语","example":"Sedang membaca ialah frasa kerja.","related":"frasa nama, frasa adjektif","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"frasa adjektif","meaning":"形容词短语","theme":"T28","level":"L4–L8","type":"frasa","usage":"frasa yang inti utamanya kata adjektif｜核心为形容词的短语","example":"Sangat rajin ialah frasa adjektif.","related":"frasa nama, frasa kerja","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"frasa sendi nama","meaning":"介词短语","theme":"T28","level":"L4–L8","type":"frasa","usage":"frasa yang bermula dengan kata sendi nama｜以介词开始的短语","example":"Di sekolah ialah frasa sendi nama.","related":"kata sendi nama, frasa","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat penyata","meaning":"陈述句","theme":"T28","level":"L2–L8","type":"tugas","usage":"ayat yang menyatakan sesuatu perkara｜陈述某件事情的句子","example":"Ali pergi ke sekolah.","related":"ayat tanya, ayat perintah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat tanya","meaning":"疑问句","theme":"T28","level":"L2–L8","type":"tugas","usage":"ayat yang digunakan untuk bertanya｜用于提问的句子","example":"Bilakah kamu datang?","related":"kata tanya, ayat penyata","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat perintah","meaning":"祈使句","theme":"T28","level":"L2–L8","type":"tugas","usage":"ayat untuk memberikan perintah, larangan atau permintaan｜用于命令、禁止或请求的句子","example":"Tolong tutup pintu.","related":"kata perintah, ayat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat seruan","meaning":"感叹句","theme":"T28","level":"L2–L8","type":"tugas","usage":"ayat yang melahirkan perasaan kuat｜表达强烈感情的句子","example":"Wah, indahnya pemandangan itu!","related":"kata seru, ayat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat aktif","meaning":"主动句","theme":"T28","level":"L4–L8","type":"tugas","usage":"ayat yang subjeknya melakukan perbuatan｜主语执行动作的句子","example":"Ali membaca buku.","related":"ayat pasif, kata kerja","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ayat pasif","meaning":"被动句","theme":"T28","level":"L4–L8","type":"tugas","usage":"ayat yang subjeknya menerima perbuatan｜主语接受动作的句子","example":"Buku dibaca oleh Ali.","related":"ayat aktif, di-","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menyatakan","meaning":"说明；陈述","theme":"T01","level":"L1–L8","type":"soalan","usage":"memberikan maklumat atau jawapan secara jelas｜清楚说出资料或答案","example":"Nyatakan dua faedah bersenam.","related":"menyenaraikan, menjelaskan, jawapan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menyenaraikan","meaning":"列出","theme":"T01","level":"L2–L8","type":"soalan","usage":"menulis atau menyebut beberapa perkara dalam senarai｜把若干项目列出来","example":"Senaraikan tiga cara menjaga kebersihan.","related":"menyatakan, mencatat, isi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menamakan","meaning":"命名；说出名称","theme":"T01","level":"L1–L6","type":"soalan","usage":"menyatakan nama sesuatu｜说出某事物的名称","example":"Namakan dua kemudahan awam.","related":"menyebut, mengenal pasti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"melengkapkan","meaning":"完成；补全","theme":"T01","level":"L1–L7","type":"soalan","usage":"mengisi bahagian yang belum lengkap｜填补未完成的部分","example":"Lengkapkan ayat dengan perkataan yang sesuai.","related":"mengisi, menyempurnakan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memadankan","meaning":"配对","theme":"T01","level":"L1–L6","type":"soalan","usage":"menghubungkan dua perkara yang sepadan｜把相对应的两项连接起来","example":"Padankan perkataan dengan gambar.","related":"menghubungkan, memilih","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengelaskan","meaning":"分类","theme":"T01","level":"L2–L8","type":"soalan","usage":"membahagikan perkara mengikut ciri atau kumpulan｜按特征或类别分组","example":"Kelaskan perkataan mengikut golongan kata.","related":"kategori, mengumpulkan, ciri","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menyusun","meaning":"排列；整理","theme":"T01","level":"L1–L8","type":"soalan","usage":"meletakkan sesuatu mengikut urutan atau aturan｜按顺序或规则排列","example":"Susun perkataan menjadi ayat yang betul.","related":"urutan, mengatur","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"membina ayat","meaning":"造句","theme":"T01","level":"L1–L8","type":"soalan","usage":"menghasilkan ayat menggunakan perkataan yang diberikan｜用给定词语组成句子","example":"Bina ayat menggunakan perkataan prihatin.","related":"ayat, menulis, perkataan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menukarkan","meaning":"转换；改成","theme":"T01","level":"L3–L8","type":"soalan","usage":"mengubah satu bentuk kepada bentuk lain｜把一种形式改成另一种形式","example":"Tukarkan ayat aktif kepada ayat pasif.","related":"mengubah, ayat aktif, ayat pasif","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"membetulkan","meaning":"改正","theme":"T01","level":"L1–L8","type":"soalan","usage":"memperbaiki kesalahan supaya menjadi betul｜把错误改正确","example":"Betulkan kesalahan ejaan.","related":"kesalahan, menyunting","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"}]