[{"word":"menyunting","meaning":"编辑；校订","theme":"T01","level":"L4–L8","type":"soalan","usage":"membetulkan dan memperbaik bahasa atau tulisan｜修改并改善语言或文章","example":"Sunting karangan sebelum dihantar.","related":"membetulkan, ejaan, tatabahasa","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mencatat","meaning":"记录；记下","theme":"T01","level":"L1–L8","type":"soalan","usage":"menulis maklumat penting secara ringkas｜简要记下重要资料","example":"Catat isi penting semasa membaca.","related":"merekod, maklumat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"merekod","meaning":"记录","theme":"T01","level":"L3–L8","type":"soalan","usage":"mencatat maklumat untuk rujukan semula｜记录资料以便再次查阅","example":"Rekod hasil perbincangan kumpulan.","related":"mencatat, data","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menggariskan","meaning":"划线；标出","theme":"T01","level":"L1–L6","type":"soalan","usage":"membuat garis pada bahagian penting｜在重要部分划线","example":"Gariskan kata adjektif.","related":"menandakan, kata kunci","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menandakan","meaning":"标记；注明","theme":"T01","level":"L1–L7","type":"soalan","usage":"memberikan tanda pada jawapan atau maklumat｜在答案或资料上作标记","example":"Tandakan jawapan yang betul.","related":"memilih, menggariskan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memilih","meaning":"选择","theme":"T01","level":"L1–L8","type":"soalan","usage":"menentukan pilihan yang sesuai｜选出适当选项","example":"Pilih jawapan yang paling tepat.","related":"menentukan, menandakan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menentukan","meaning":"确定；判断","theme":"T01","level":"L2–L8","type":"soalan","usage":"membuat keputusan berdasarkan maklumat｜根据资料作判断","example":"Tentukan maksud perkataan berdasarkan konteks.","related":"mengenal pasti, memilih","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengenal pasti","meaning":"识别；找出","theme":"T01","level":"L2–L8","type":"soalan","usage":"mencari dan menentukan maklumat tertentu｜找出并确定特定资料","example":"Kenal pasti kata kerja dalam petikan.","related":"menentukan, mengecam","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengecam","meaning":"辨认；识别","theme":"T01","level":"L1–L6","type":"soalan","usage":"mengenali sesuatu berdasarkan ciri｜根据特征辨认","example":"Murid mengecam bunyi yang didengar.","related":"mengenal pasti, mengenali","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menerangkan","meaning":"说明；解释","theme":"T01","level":"L2–L8","type":"soalan","usage":"memberikan penerangan supaya sesuatu difahami｜说明某事使人理解","example":"Terangkan sebab watak itu sedih.","related":"menjelaskan, menghuraikan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menjelaskan","meaning":"解释清楚；说明","theme":"T01","level":"L2–L8","type":"soalan","usage":"menerangkan sesuatu dengan jelas｜把某事解释清楚","example":"Jelaskan kepentingan menjaga kebersihan.","related":"menerangkan, menghuraikan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menghuraikan","meaning":"阐述；详细说明","theme":"T01","level":"L3–L8","type":"soalan","usage":"mengembangkan isi dengan penerangan, sebab atau contoh｜用说明、原因或例子扩展要点","example":"Huraikan langkah menjaga alam sekitar.","related":"menjelaskan, contoh, isi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memperincikan","meaning":"详述；细化","theme":"T01","level":"L5–L8","type":"soalan","usage":"memberikan butiran yang lebih khusus｜提供更具体的细节","example":"Perincikan cadangan anda.","related":"menghuraikan, butiran","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"membandingkan","meaning":"比较","theme":"T01","level":"L2–L8","type":"soalan","usage":"mencari persamaan dan perbezaan｜找出相同与不同之处","example":"Bandingkan kedua-dua bahan.","related":"membezakan, persamaan, perbezaan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"membezakan","meaning":"区分；辨别差异","theme":"T01","level":"L2–L8","type":"soalan","usage":"menentukan perbezaan antara perkara｜判断事物之间的不同","example":"Bezakan fakta dengan pendapat.","related":"membandingkan, perbezaan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menghubungkaitkan","meaning":"联系；关联","theme":"T01","level":"L4–L8","type":"soalan","usage":"mengaitkan satu maklumat dengan maklumat lain｜把一个资料与另一个联系起来","example":"Hubungkaitkan bahan dengan pengalaman anda.","related":"mengaitkan, hubungan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mentafsir","meaning":"解读；诠释","theme":"T01","level":"L3–L8","type":"soalan","usage":"memberikan makna berdasarkan teks, data atau grafik｜根据文本、数据或图表作解释","example":"Tafsir maklumat dalam carta.","related":"tafsiran, data, graf","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menganalisis","meaning":"分析","theme":"T01","level":"L4–L8","type":"soalan","usage":"meneliti maklumat untuk melihat hubungan atau sebab｜分析资料中的关系或原因","example":"Analisis punca masalah tersebut.","related":"meneliti, menilai, punca","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menilai","meaning":"评价；评估","theme":"T01","level":"L4–L8","type":"soalan","usage":"membuat pertimbangan berdasarkan maklumat atau bukti｜根据资料或证据作判断","example":"Nilai keberkesanan langkah itu.","related":"bukti, hujah, pertimbangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"merumuskan","meaning":"归纳；总结","theme":"T01","level":"L4–L8","type":"soalan","usage":"menyatakan isi penting atau kesimpulan｜归纳重点或结论","example":"Rumuskan maklumat daripada bahan.","related":"ringkasan, kesimpulan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"menyimpulkan","meaning":"得出结论","theme":"T01","level":"L3–L8","type":"soalan","usage":"membuat kesimpulan berdasarkan maklumat｜根据资料得出结论","example":"Simpulkan pengajaran daripada cerita.","related":"kesimpulan, rumusan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mencadangkan","meaning":"建议；提出方法","theme":"T24","level":"L2–L8","type":"soalan","usage":"memberikan idea tentang tindakan atau penyelesaian｜提出行动或解决办法","example":"Cadangkan dua langkah mengurangkan pencemaran.","related":"cadangan, langkah, penyelesaian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mewajarkan","meaning":"论证合理性；说明理由","theme":"T01","level":"L5–L8","type":"soalan","usage":"memberikan alasan yang munasabah untuk menyokong sesuatu｜给出合理理由支持某观点","example":"Wajarkan pilihan anda dengan bukti.","related":"alasan, bukti, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"membuktikan","meaning":"证明","theme":"T01","level":"L4–L8","type":"soalan","usage":"menunjukkan kebenaran sesuatu dengan bukti｜用证据说明某事为真","example":"Buktikan jawapan anda berdasarkan petikan.","related":"bukti, fakta, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"meramalkan","meaning":"预测","theme":"T01","level":"L3–L8","type":"soalan","usage":"menyatakan perkara yang mungkin berlaku berdasarkan maklumat｜根据资料说明可能发生的事情","example":"Ramalkan kesan jika hujan berterusan.","related":"jangkaan, kemungkinan, kesan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengemukakan pendapat","meaning":"提出意见","theme":"T01","level":"L3–L8","type":"soalan","usage":"menyatakan pandangan sendiri secara sesuai｜适当地表达个人看法","example":"Kemukakan pendapat anda tentang isu itu.","related":"pendapat, pandangan, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memberikan alasan","meaning":"给出理由","theme":"T01","level":"L2–L8","type":"soalan","usage":"menyatakan sebab yang menyokong jawapan｜说明支持答案的原因","example":"Berikan alasan bagi pilihan anda.","related":"alasan, sebab, bukti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"memberikan contoh","meaning":"举例","theme":"T01","level":"L1–L8","type":"soalan","usage":"menyatakan contoh yang sesuai untuk menyokong penerangan｜给出适当例子支持说明","example":"Berikan contoh amalan berjimat cermat.","related":"contoh, huraian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengambil langkah","meaning":"采取措施","theme":"T24","level":"L3–L8","type":"frasa","usage":"digunakan untuk menyatakan tindakan bagi menangani masalah｜表示为处理问题而采取行动","example":"Pihak sekolah mengambil langkah meningkatkan keselamatan.","related":"langkah, tindakan, usaha","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"mengatasi masalah","meaning":"克服问题","theme":"T24","level":"L3–L8","type":"frasa","usage":"digunakan apabila sesuatu masalah berjaya ditangani｜用于说明问题被克服","example":"Kita perlu bekerjasama untuk mengatasi masalah pencemaran.","related":"menangani masalah, penyelesaian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"}]