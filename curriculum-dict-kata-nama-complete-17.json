a","example":"Ayat boleh dibina daripada beberapa jenis frasa.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"ayat","meaning":"句子","theme":"T28","type":"nama","usage":"membina ayat; ayat gramatis","example":"Murid membina ayat yang gramatis.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"perkataan","meaning":"词；单词","theme":"T28","type":"nama","usage":"maksud perkataan; pilihan perkataan","example":"Pilih perkataan yang sesuai dengan konteks.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"imbuhan","meaning":"词缀","theme":"T28","type":"nama","usage":"penggunaan imbuhan; imbuhan awalan","example":"Imbuhan boleh mengubah bentuk dan fungsi kata.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"ejaan","meaning":"拼写","theme":"T28","type":"nama","usage":"ejaan betul; kesalahan ejaan","example":"Murid perlu menyemak ejaan sebelum menghantar karangan.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"tanda baca","meaning":"标点符号","theme":"T28","type":"nama","usage":"penggunaan tanda baca; tanda baca yang betul","example":"Tanda baca membantu menjelaskan maksud ayat.","source":"DSKP/KSSR/KSSM/UASA"},{"word":"tatabahasa","meaning":"语法","theme":"T28","type":"nama","usage":"penguasaan tatabahasa; kesalahan tatabahasa","example":"Penguasaan tatabahasa membantu murid menulis dengan tepat.","source":"DSKP/KSSR/KSSM/UASA"}]