[{"word":"kesimpulan","meaning":"结论","theme":"T25","level":"L3–L8","type":"penulisan","usage":"rumusan akhir berdasarkan isi atau bukti｜根据要点或证据作出的最终结论","example":"Kesimpulan mesti berkaitan dengan tajuk.","related":"rumusan, penutup, bukti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"perenggan","meaning":"段落","theme":"T06","level":"L2–L8","type":"penulisan","usage":"kumpulan ayat tentang satu fokus idea｜围绕一个重点的一组句子","example":"Tulis satu isi bagi setiap perenggan.","related":"ayat, isi, karangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"karangan","meaning":"作文","theme":"T06","level":"L2–L8","type":"penulisan","usage":"penulisan tersusun tentang sesuatu tajuk｜围绕题目完成的文章","example":"Murid menulis karangan tentang pengalaman bercuti.","related":"pendahuluan, isi, penutup","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"format","meaning":"格式","theme":"T06","level":"L3–L8","type":"penulisan","usage":"susunan yang perlu dipatuhi bagi sesuatu bentuk penulisan｜文体需要遵守的结构","example":"Laporan perlu mengikut format yang betul.","related":"laporan, surat rasmi, karangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"laporan","meaning":"报告","theme":"T06","level":"L4–L8","type":"penulisan","usage":"penulisan yang merekodkan kegiatan atau kejadian｜记录活动或事件的文体","example":"Setiausaha menulis laporan aktiviti.","related":"format, aktiviti, maklumat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"rencana","meaning":"专题文章；评论文章","theme":"T06","level":"L5–L8","type":"penulisan","usage":"penulisan yang menghuraikan isu secara teratur｜有条理阐述议题的文章","example":"Rencana itu membincangkan amalan membaca.","related":"artikel, isu, huraian","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"artikel","meaning":"文章","theme":"T06","level":"L4–L8","type":"penulisan","usage":"tulisan yang memberikan maklumat atau pandangan｜提供资料或观点的文章","example":"Murid membaca artikel tentang kesihatan.","related":"rencana, maklumat, tajuk","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"syarahan","meaning":"演讲","theme":"T06","level":"L4–L8","type":"penulisan","usage":"ucapan formal tentang sesuatu tajuk｜关于某主题的正式演说","example":"Dia menyampaikan syarahan tentang keselamatan.","related":"ucapan, pidato, tajuk","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ucapan","meaning":"致辞；讲话","theme":"T06","level":"L3–L8","type":"penulisan","usage":"kata-kata yang disampaikan dalam sesuatu majlis｜在场合中发表的话语","example":"Guru besar menyampaikan ucapan perasmian.","related":"syarahan, majlis, pidato","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pidato","meaning":"演说；演讲","theme":"T06","level":"L4–L8","type":"penulisan","usage":"penyampaian idea secara lisan dan meyakinkan｜有说服力地口头表达观点","example":"Murid itu menyertai pertandingan pidato.","related":"syarahan, hujah, ucapan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata nama am","meaning":"普通名词","theme":"T28","level":"L2–L8","type":"nama","usage":"kata nama umum untuk orang, benda, tempat atau perkara｜表示一般人事物地点的名词","example":"Sekolah ialah kata nama am.","related":"kata nama, kata nama khas","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata nama khas","meaning":"专有名词","theme":"T28","level":"L2–L8","type":"nama","usage":"nama khusus bagi orang, tempat atau institusi｜特定人名、地名或机构名","example":"Pulau Pinang ialah kata nama khas.","related":"kata nama, kata nama am","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata ganti nama diri","meaning":"人称代词","theme":"T28","level":"L1–L8","type":"tugas","usage":"kata yang menggantikan nama orang｜代替人名的词","example":"Saya ialah kata ganti nama diri pertama.","related":"saya, awak, beliau","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata kerja transitif","meaning":"及物动词","theme":"T28","level":"L4–L8","type":"kerja","usage":"kata kerja yang memerlukan objek｜需要宾语的动词","example":"Ali membaca buku.","related":"objek, kata kerja","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata kerja tak transitif","meaning":"不及物动词","theme":"T28","level":"L4–L8","type":"kerja","usage":"kata kerja yang tidak memerlukan objek｜不需要宾语的动词","example":"Adik tidur.","related":"kata kerja, predikat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata adjektif","meaning":"形容词","theme":"T02","level":"L2–L8","type":"adjektif","usage":"kata yang menerangkan sifat atau keadaan｜说明性质或状态的词","example":"Cantik ialah kata adjektif.","related":"sifat, keadaan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata hubung","meaning":"连词","theme":"T26","level":"L2–L8","type":"tugas","usage":"kata yang menghubungkan perkataan, frasa atau ayat｜连接词、短语或句子的词","example":"Ali membaca dan menulis.","related":"dan, tetapi, kerana","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata sendi nama","meaning":"介词","theme":"T27","level":"L2–L8","type":"tugas","usage":"kata di hadapan frasa nama untuk menunjukkan hubungan tertentu｜位于名词短语前表示关系的词","example":"Buku itu di atas meja.","related":"di, ke, dari, daripada","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata arah","meaning":"方位词","theme":"T27","level":"L1–L8","type":"tugas","usage":"kata yang menunjukkan arah atau kedudukan｜表示方向或位置的词","example":"Kucing itu di bawah meja.","related":"atas, bawah, hadapan, belakang","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata bilangan","meaning":"数词；数量词","theme":"T28","level":"L2–L8","type":"tugas","usage":"kata yang menunjukkan jumlah atau bilangan｜表示数量的词","example":"Beberapa murid hadir.","related":"semua, beberapa, kedua-dua","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"penjodoh bilangan","meaning":"量词","theme":"T28","level":"L1–L6","type":"tugas","usage":"kata yang digunakan untuk membilang benda tertentu｜用于计算特定事物的量词","example":"Sebatang pensel ada di meja.","related":"batang, buah, helai","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata tanya","meaning":"疑问词","theme":"T28","level":"L1–L8","type":"tugas","usage":"kata yang digunakan untuk bertanya｜用于提问的词","example":"Siapa yang datang tadi?","related":"apa, siapa, bila, mengapa","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata perintah","meaning":"祈使词；命令词","theme":"T28","level":"L2–L8","type":"tugas","usage":"kata untuk perintah, larangan, silaan atau permintaan｜用于命令、禁止、邀请或请求","example":"Sila duduk.","related":"sila, jangan, tolong, harap","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata seru","meaning":"感叹词","theme":"T28","level":"L2–L7","type":"tugas","usage":"kata yang melahirkan perasaan secara spontan｜表达即时感情的词","example":"Wah, cantiknya!","related":"wah, aduh, amboi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata nafi","meaning":"否定词","theme":"T28","level":"L3–L8","type":"tugas","usage":"kata yang menafikan frasa tertentu｜用于否定某些短语的词","example":"Dia bukan ketua kelas.","related":"bukan, tidak","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata pemeri","meaning":"系词","theme":"T28","level":"L4–L8","type":"tugas","usage":"kata yang menghubungkan subjek dengan predikat tertentu｜连接主语与特定谓语的词","example":"Tujuan program ini adalah untuk membantu murid.","related":"ialah, adalah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata bantu","meaning":"助动词","theme":"T28","level":"L3–L8","type":"tugas","usage":"kata yang membantu frasa kerja dari segi masa atau ragam｜从时间或语气方面辅助动词短语","example":"Dia sedang membaca.","related":"telah, sedang, akan, boleh","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata penguat","meaning":"程度加强词","theme":"T28","level":"L3–L8","type":"tugas","usage":"kata yang menguatkan maksud kata adjektif｜加强形容词程度的词","example":"Pemandangan itu sangat indah.","related":"sangat, amat, terlalu, paling","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata penegas","meaning":"强调词","theme":"T28","level":"L4–L8","type":"tugas","usage":"kata yang memberikan penegasan pada bahagian ayat｜强调句中某部分的词","example":"Dialah ketua pasukan.","related":"-lah, -kah, juga, sahaja","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata pembenar","meaning":"肯定词","theme":"T28","level":"L3–L7","type":"tugas","usage":"kata yang mengesahkan sesuatu pernyataan｜确认某陈述的词","example":"Ya, saya sudah bersedia.","related":"ya, benar, betul","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"}]