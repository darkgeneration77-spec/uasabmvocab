[{"word":"arahan","meaning":"指示；题目要求","theme":"T06","level":"L1–L8","type":"soalan","usage":"menunjukkan perkara yang perlu dilakukan｜说明需要做什么","example":"Baca arahan dengan teliti.","related":"soalan, tugasan, petunjuk","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kehendak soalan","meaning":"题目要求","theme":"T06","level":"L2–L8","type":"soalan","usage":"perkara sebenar yang diminta oleh soalan｜题目真正要求回答的内容","example":"Fahami kehendak soalan sebelum menjawab.","related":"arahan, kata kunci, jawapan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"kata kunci","meaning":"关键词","theme":"T06","level":"L1–L8","type":"soalan","usage":"perkataan penting yang menentukan fokus jawapan｜决定答案重点的重要词","example":"Gariskan kata kunci dalam soalan.","related":"fokus, isi, arahan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"petunjuk","meaning":"提示；线索","theme":"T06","level":"L1–L8","type":"soalan","usage":"maklumat yang membantu mencari jawapan｜帮助找答案的线索","example":"Gunakan petunjuk dalam gambar.","related":"maklumat, bukti, konteks","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"jawapan","meaning":"答案","theme":"T06","level":"L1–L8","type":"soalan","usage":"respons terhadap soalan atau tugasan｜对问题或任务的回答","example":"Tulis jawapan dengan ayat lengkap.","related":"soalan, respons, isi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"respons","meaning":"回应；作答","theme":"T06","level":"L1–L8","type":"soalan","usage":"tindak balas lisan atau bertulis｜口头或书面回应","example":"Berikan respons yang sesuai.","related":"jawapan, pendapat, ulasan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"fokus","meaning":"重点；焦点","theme":"T06","level":"L3–L8","type":"soalan","usage":"perkara utama yang diberi perhatian｜需要重点关注的内容","example":"Pastikan jawapan kekal pada fokus soalan.","related":"tajuk, isi, kehendak soalan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"tajuk","meaning":"题目；标题","theme":"T06","level":"L1–L8","type":"penulisan","usage":"pokok sesuatu penulisan atau perbincangan｜文章或讨论的主题","example":"Baca tajuk sebelum merancang isi.","related":"tema, fokus, karangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"isi utama","meaning":"主要内容","theme":"T06","level":"L2–L8","type":"soalan","usage":"maklumat terpenting dalam bahan｜材料中最重要的内容","example":"Kenal pasti isi utama petikan.","related":"idea utama, isi sampingan, maklumat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"isi sampingan","meaning":"辅助内容","theme":"T06","level":"L3–L8","type":"soalan","usage":"maklumat tambahan yang menyokong isi utama｜支持主要内容的补充资料","example":"Isi sampingan menjelaskan isi utama.","related":"isi utama, huraian, contoh","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"isi tersurat","meaning":"明示内容","theme":"T06","level":"L3–L8","type":"soalan","usage":"maklumat yang dinyatakan secara langsung｜直接写出的信息","example":"Cari dua isi tersurat daripada petikan.","related":"isi tersirat, petikan, maklumat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"isi tersirat","meaning":"隐含内容","theme":"T06","level":"L3–L8","type":"soalan","usage":"maklumat yang difahami melalui penaakulan｜通过推理得到的信息","example":"Berikan satu isi tersirat berdasarkan poster.","related":"isi tersurat, inferens, menaakul","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"idea utama","meaning":"中心思想；主旨","theme":"T06","level":"L3–L8","type":"soalan","usage":"idea paling penting dalam teks｜文本中最重要的思想","example":"Nyatakan idea utama petikan.","related":"isi utama, tema, idea sampingan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"idea sampingan","meaning":"辅助观点","theme":"T06","level":"L3–L8","type":"soalan","usage":"idea yang menyokong idea utama｜支持中心思想的观点","example":"Idea sampingan memberikan maklumat tambahan.","related":"idea utama, huraian, contoh","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"inferens","meaning":"推论","theme":"T06","level":"L3–L8","type":"soalan","usage":"kesimpulan berdasarkan bukti atau maklumat｜根据证据或资料作出的推论","example":"Buat inferens berdasarkan tindakan watak.","related":"bukti, menaakul, kesimpulan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"andaian","meaning":"假设；推测","theme":"T06","level":"L4–L8","type":"soalan","usage":"anggapan yang digunakan dalam pertimbangan｜用于分析的暂时假设","example":"Jangan membuat andaian tanpa bukti.","related":"inferens, bukti, kemungkinan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"tafsiran","meaning":"解读；诠释","theme":"T06","level":"L4–L8","type":"soalan","usage":"penerangan tentang makna bahan atau data｜对材料或数据意义的解释","example":"Tafsiran graf mesti berdasarkan data.","related":"mentafsir, data, makna","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"bukti","meaning":"证据","theme":"T06","level":"L3–L8","type":"soalan","usage":"maklumat yang menyokong jawapan atau pendapat｜支持答案或观点的资料","example":"Berikan bukti daripada petikan.","related":"fakta, alasan, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"fakta","meaning":"事实","theme":"T06","level":"L3–L8","type":"soalan","usage":"maklumat yang boleh dibuktikan benar｜可以验证真假的资料","example":"Bezakan fakta dengan pendapat.","related":"pendapat, bukti, maklumat","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pendapat","meaning":"意见；看法","theme":"T06","level":"L2–L8","type":"soalan","usage":"pandangan seseorang tentang sesuatu perkara｜个人看法","example":"Berikan pendapat anda tentang amalan membaca.","related":"pandangan, alasan, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pandangan","meaning":"观点；看法","theme":"T06","level":"L3–L8","type":"soalan","usage":"cara seseorang melihat sesuatu isu｜个人看待议题的方式","example":"Kemukakan pandangan anda dengan sopan.","related":"pendapat, hujah, alasan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"alasan","meaning":"理由","theme":"T25","level":"L2–L8","type":"soalan","usage":"sebab yang menyokong jawapan atau pilihan｜支持答案或选择的理由","example":"Berikan alasan bagi jawapan anda.","related":"sebab, bukti, hujah","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"hujah","meaning":"论点；论证","theme":"T25","level":"L4–L8","type":"soalan","usage":"pendapat yang disokong alasan dan bukti｜由理由和证据支持的观点","example":"Hujah yang jelas lebih meyakinkan.","related":"pendapat, alasan, bukti","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"rumusan","meaning":"总结；概括","theme":"T06","level":"L4–L8","type":"penulisan","usage":"penyampaian isi penting secara padat｜简洁概括重点","example":"Tulis rumusan berdasarkan petikan.","related":"ringkasan, kesimpulan, isi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ringkasan","meaning":"摘要；简写","theme":"T06","level":"L3–L8","type":"penulisan","usage":"isi penting yang ditulis semula secara lebih pendek｜较短地重述重点","example":"Tulis ringkasan tentang faedah bersukan.","related":"rumusan, isi utama, petikan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"ulasan","meaning":"评述；短评","theme":"T06","level":"L3–L8","type":"penulisan","usage":"respons bertulis yang menghuraikan bahan｜根据材料作出的书面评述","example":"Tulis ulasan berdasarkan bahan rangsangan.","related":"huraian, pendapat, bahan rangsangan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"huraian","meaning":"阐述；说明","theme":"T06","level":"L3–L8","type":"penulisan","usage":"penerangan yang mengembangkan isi｜扩展说明要点","example":"Setiap isi perlu disertai huraian.","related":"isi, contoh, penjelasan","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"contoh","meaning":"例子","theme":"T06","level":"L1–L8","type":"penulisan","usage":"perkara khusus untuk menerangkan idea｜用于说明观点的具体例子","example":"Berikan satu contoh amalan hidup sihat.","related":"huraian, bukti, isi","source":"DSKP/KSSR/KSSM/UASA · DBP/PRPM-guided"},{"word":"pendahuluan","meaning":"开头；引言","theme":"T06","level":"L3–L8","type":"penulisan","usage":"bahagian awal yang memperkenalkan tajuk｜介绍题目的开头部分","example":"Karangan 